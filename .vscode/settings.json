{
    "files.associations": {
        "*.ears.md": "markdown"
    },
    "highlight.regexes": {
        "(\\b(?:While|When|Where|If|then)\\b)": [
            { "color": "#66b3ff", "fontWeight": "bold" }
        ],
        "(\\b(?:The|shall)\\b)": [
            { "color": "#f8f9fa", "fontWeight": "bold" }
        ],
        "(<[a-zA-Z0-9_ -]+>)": [
            { "color": "#ff6b6b", "fontStyle": "italic" }
        ],
        "(\\[STABLE\\])": [
            { "backgroundColor": "#1e4620", "color": "#51cf66", "borderRadius": "4px" }
        ],
        "(\\[DRAFT\\])": [
            { "backgroundColor": "#4a3512", "color": "#fcc419", "borderRadius": "4px" }
        ]
    },
    "todo-tree.filtering.includeGlobs": [
        "**/*.ears.md"
    ],
    "todo-tree.regex.regex": "(\\[DRAFT\\]|\\[STABLE\\]|#Ubiquitous|#State-Driven|#Event-Driven|#Option-Driven|#Unwanted)",
    "todo-tree.general.tags": [
        "[DRAFT]",
        "[STABLE]",
        "#Ubiquitous",
        "#State-Driven",
        "#Event-Driven",
        "#Option-Driven",
        "#Unwanted"
    ],
    "todo-tree.tree.showScanModeButton": false,
    "todo-tree.highlights.enabled": false,
    "todo-tree.tree.groupedByTag": true
}
