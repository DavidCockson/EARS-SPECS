{
  "name": "ears-specs",
  "displayName": "EARS Specs",
  "description": "Draft, autocomplete, and auto-organise EARS requirements (.ears.md) into the 5 EARS archetypes.",
  "version": "0.2.1",
  "publisher": "davidcockson",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#5b9bd5",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "EARS",
    "requirements",
    "requirements engineering",
    "systems engineering",
    "specification",
    "spec-driven",
    "ears syntax",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/davidcockson-compliance/EARS-SPECS.git"
  },
  "bugs": {
    "url": "https://github.com/davidcockson-compliance/EARS-SPECS/issues"
  },
  "homepage": "https://github.com/davidcockson-compliance/EARS-SPECS#readme",
  "main": "./extension.js",
  "scripts": {
    "test": "node ./test/runTest.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configurationDefaults": {
      "files.associations": {
        "*.ears.md": "markdown"
      },
      "[markdown]": {
        "editor.tabCompletion": "onlySnippets"
      }
    },
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/ears.json"
      }
    ],
    "commands": [
      {
        "command": "ears.organize",
        "title": "EARS: Organize Document into 5 Types",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "ears.newSpec",
        "title": "EARS: New Spec File",
        "icon": "$(new-file)"
      },
      {
        "command": "ears.refreshOutline",
        "title": "EARS: Refresh Outline",
        "icon": "$(refresh)"
      },
      {
        "command": "ears.goto",
        "title": "EARS: Go to Requirement"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "earsExplorer",
          "title": "EARS",
          "icon": "media/ears.svg"
        }
      ]
    },
    "views": {
      "earsExplorer": [
        {
          "id": "earsOutline",
          "name": "Requirements",
          "icon": "media/ears.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ears.organize",
          "when": "view == earsOutline",
          "group": "navigation@1"
        },
        {
          "command": "ears.newSpec",
          "when": "view == earsOutline",
          "group": "navigation@2"
        },
        {
          "command": "ears.refreshOutline",
          "when": "view == earsOutline",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "ears.goto",
          "when": "false"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "glob": "^13.0.6",
    "mocha": "^11.7.6"
  }
}
